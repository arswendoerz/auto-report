# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env asli.

TIKTOK_EMAIL=
TIKTOK_PASSWORD=

EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ACCOUNT=
# App Password Gmail (bukan password akun biasa), lihat:
# https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=

# TARGET_VIDEO_URL sudah TIDAK dipakai lagi.
# Link video ditanyakan langsung saat menjalankan `python main.py`.

# ===== PERFORMA (semua opsional) =====
# Browser tanpa jendela. Lebih cepat, tapi TikTok lebih sering minta verifikasi.
HEADLESS=false
# Blokir stream video/font + host telemetri saat memuat halaman.
BLOCK_HEAVY_RESOURCES=true
# Blokir gambar juga. Lebih cepat lagi, TAPI tampilan captcha ikut hilang.
BLOCK_IMAGES=false
# Timeout (ms) untuk transisi UI lokal.
FAST_TIMEOUT=3000
# Timeout (ms) untuk elemen yang menunggu response jaringan.
SLOW_TIMEOUT=10000
# Berhenti di "Tekan Enter untuk menutup browser" seperti versi lama.
PAUSE_AT_END=false
# Keluar dari akun setelah report selesai lalu hapus file sesi.
# PERINGATAN: menyalakan ini memaksa login penuh + OTP di setiap run,
# yang justru memperbesar peluang munculnya captcha dan flag anti-bot.
LOGOUT_AFTER_REPORT=false
# Hapus file sesi otomatis HANYA kalau sesinya terdeteksi rusak (halaman
# video menampilkan "Log masuk"). Ini BUKAN hapus-sesi-tiap-run: sesi yang
# sehat justru yang membuat script melewati login, OTP, dan captcha.
AUTO_CLEAR_STALE_SESSION=true
